    {
      "name": "20. HR views all balances",
      "description": "Use the HR persona to verify the role-restricted all-user balances endpoint after approve, reject, and cancel operations.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{hrAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/balances"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HR all-balances report is available\", () => pm.response.to.have.status(200));",
              "const balances = pm.response.json();",
              "const vacation = balances.find(balance => String(balance.userId) === pm.environment.get(\"approveEmployeeId\") && Number(balance.leaveTypeId) === Number(pm.environment.get(\"vacationLeaveTypeId\")));",
              "pm.test(\"HR report includes JSmith's Vacation balance\", () => pm.expect(vacation).to.exist);",
              "pm.expect(vacation.totalDays).to.eql(19);",
              "pm.expect(vacation.reservedDays).to.eql(0);",
              "pm.expect(vacation.availableDays).to.eql(19);"
            ]
          }
        }
      ]
    },
    {
      "name": "21. HR views JSmith's Vacation ledger",
      "description": "Inspect the HR-only ledger for the approved employee. The script-saved employee ID and configured leave type ID avoid hard-coding account IDs from the seed database.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{hrAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/balances/{{approveEmployeeId}}/{{vacationLeaveTypeId}}/ledger"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HR balance ledger is available\", () => pm.response.to.have.status(200));",
              "const ledger = pm.response.json();",
              "pm.test(\"Ledger records the approved one-day deduction\", () => pm.expect(ledger.some(entry => entry.kind === \"DEDUCT\" && String(entry.requestId) === pm.environment.get(\"approvedRequestId\") && entry.changeDays === -1)).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "22. HR views the complete audit trail",
      "description": "Finish with the HR-only audit report. It demonstrates the complete request lifecycle and serves as a final verification after all employee and manager actions.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{hrAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/audit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HR audit report is available\", () => pm.response.to.have.status(200));",
              "const report = pm.response.json();",
              "const approved = report.find(request => String(request.requestId) === pm.environment.get(\"approvedRequestId\"));",
              "const rejected = report.find(request => String(request.requestId) === pm.environment.get(\"rejectRequestId\"));",
              "pm.test(\"Audit report includes JSmith's approved request\", () => pm.expect(approved).to.exist);",
              "pm.test(\"Audit report confirms approval\", () => pm.expect(approved.status).to.eql(\"APPROVED\"));",
              "pm.test(\"Audit report includes CWong's rejected request\", () => pm.expect(rejected).to.exist);",
              "pm.test(\"Audit report confirms rejection\", () => pm.expect(rejected.status).to.eql(\"REJECTED\"));",
              "pm.test(\"Audit history includes approval\", () => pm.expect(approved.history.some(entry => entry.type === \"APPROVED\")).to.eql(true));",
              "pm.test(\"Audit history includes rejection\", () => pm.expect(rejected.history.some(entry => entry.type === \"REJECTED\")).to.eql(true));"
            ]
          }
        }
      ]
    }
  ]
