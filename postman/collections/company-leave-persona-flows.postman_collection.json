            ]
          }
        }
      ]
    },
    {
      "name": "15. Manager Chen rejects CWong's request",
      "description": "Reject the second employee request with a non-blank reason, exercising the API's required rejection-comment rule.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{managerAccessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Please choose another date for team coverage.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/approvals/{{rejectRequestId}}/reject"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Manager rejects the request\", () => pm.response.to.have.status(200));",
              "const request = pm.response.json();",
              "pm.expect(request.status).to.eql(\"REJECTED\");",
              "pm.expect(request.decisionComment).to.eql(\"Please choose another date for team coverage.\");"
            ]
          }
        }
      ]
    },
    {
      "name": "16. JSmith checks notifications",
      "description": "Return to the approval-flow employee and verify their authenticated notification history endpoint after the manager decision.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{approveEmployeeAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee notification history is available\", () => pm.response.to.have.status(200));",
              "const notifications = pm.response.json();",
              "pm.test(\"JSmith received the approval notification\", () => pm.expect(notifications.some(notification => String(notification.requestId) === pm.environment.get(\"approvedRequestId\") && notification.kind === \"APPROVED\")).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. JSmith checks request history",
