          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/requests"
      }
    },
    {
      "name": "09. ALee cancels the pending request",
      "description": "Cancel while the request is still pending. The API should release its reservation; the next request confirms the terminal status.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{cancelEmployeeAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/requests/{{cancelRequestId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pending request is cancelled\", () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql(\"CANCELLED\");"
            ]
          }
        }
      ]
    },
    {
      "name": "10. ALee verifies the reservation was released",
      "description": "Check ALee's balances after cancellation. The canceled request response already confirmed CANCELLED; this verifies the reserved Vacation day was returned.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{cancelEmployeeAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/balances/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ALee balances are available after cancellation\", () => pm.response.to.have.status(200));",
              "const balances = pm.response.json();",
              "const vacation = balances.find(balance => Number(balance.leaveTypeId) === Number(pm.environment.get(\"vacationLeaveTypeId\")));",
              "pm.test(\"Vacation balance is present\", () => pm.expect(vacation).to.exist);",
              "pm.expect(vacation.reservedDays).to.eql(0);",
              "pm.expect(vacation.availableDays).to.eql(20);"
            ]
          }
        }
      ]
    },
