{
  "info": {
    "_postman_id": "6d143c0a-30f3-4f4e-b270-1133d2b23171",
    "name": "Company Leave API - Persona Flows",
    "description": "Ordered, stateful walkthrough using seeded HR, manager, and employee accounts. Run requests from 01 onward with the Company Leave - Local environment selected. It creates three leave requests (one approved, one rejected, one cancelled) and changes the approved employee's balance. Intended for a disposable/local database, not production. The environment defaults to the direct backend URL; for Docker Compose use https://localhost/api and disable SSL verification for the self-signed local certificate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Log in as HR",
      "description": "Start with the HR persona. The test script saves the access_token cookie and HR user ID to environment variables for later HR-only balance, ledger, and audit requests.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{hrUsername}}\",\n  \"password\": \"{{seedPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"hrAccessToken\");",
              "pm.environment.unset(\"hrUserId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HR login succeeds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const user = pm.response.json();",
              "  pm.test(\"Logged-in account is HR\", () => pm.expect(user.role).to.eql(\"HR_ADMIN\"));",
              "  if (user.role !== \"HR_ADMIN\") {",
              "    pm.execution.setNextRequest(null);",
              "  } else {",
              "    pm.environment.set(\"hrUserId\", String(user.id));",
              "    const cookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
              "    const match = cookie.match(/(?:^|[,;]\\s*)access_token=([^;]+)/i);",
              "    pm.test(\"HR access_token cookie is returned\", () => pm.expect(match).to.not.equal(null));",
              "    if (match) pm.environment.set(\"hrAccessToken\", match[1]);",
              "    else pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Log in as manager Chen",
      "description": "Create a separate manager session. This seeded manager approves and rejects the pending requests submitted by employees reporting to Chen.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{managerUsername}}\",\n  \"password\": \"{{seedPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"managerAccessToken\");",
              "pm.environment.unset(\"managerUserId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Manager login succeeds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const user = pm.response.json();",
              "  pm.test(\"Logged-in account is a manager\", () => pm.expect(user.role).to.eql(\"MANAGER\"));",
              "  if (user.role !== \"MANAGER\") {",
              "    pm.execution.setNextRequest(null);",
              "  } else {",
              "    pm.environment.set(\"managerUserId\", String(user.id));",
              "    const cookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
              "    const match = cookie.match(/(?:^|[,;]\\s*)access_token=([^;]+)/i);",
              "    pm.test(\"Manager access_token cookie is returned\", () => pm.expect(match).to.not.equal(null));",
              "    if (match) pm.environment.set(\"managerAccessToken\", match[1]);",
              "    else pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
