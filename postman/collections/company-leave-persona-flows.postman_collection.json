              "  if (user.role !== \"EMPLOYEE\") {",
              "    pm.execution.setNextRequest(null);",
              "  } else {",
              "    pm.environment.set(\"approveEmployeeId\", String(user.id));",
              "    const cookie = pm.response.headers.get(\"Set-Cookie\") || \"\";",
              "    const match = cookie.match(/(?:^|[,;]\\s*)access_token=([^;]+)/i);",
              "    pm.test(\"Employee access_token cookie is returned\", () => pm.expect(match).to.not.equal(null));",
              "    if (match) pm.environment.set(\"approveEmployeeAccessToken\", match[1]);",
              "    else pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04. JSmith views personal balances",
      "description": "Verify that an employee can view their own balances before creating a request. The same seeded Vacation balance will be reflected in the HR ledger later.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{approveEmployeeAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/balances/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Personal balances are available\", () => pm.response.to.have.status(200));",
              "const balances = pm.response.json();",
              "const vacation = balances.find(balance => Number(balance.leaveTypeId) === Number(pm.environment.get(\"vacationLeaveTypeId\")));",
              "pm.test(\"Seeded Vacation balance is available\", () => pm.expect(vacation).to.exist);",
              "pm.expect(vacation.totalDays).to.eql(20);",
              "pm.expect(vacation.reservedDays).to.eql(0);",
              "pm.expect(vacation.availableDays).to.eql(20);"
            ]
          }
        }
      ]
    },
    {
      "name": "05. JSmith submits a request for approval",
      "description": "Create a one-weekday Vacation request. The pre-request script chooses the next weekday dynamically; the response script saves the generated request ID for manager approval and history lookups.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"approvedRequestId\");",
              "const date = new Date();",
              "date.setUTCDate(date.getUTCDate() + 7);",
              "while (date.getUTCDay() === 0 || date.getUTCDay() === 6) date.setUTCDate(date.getUTCDate() + 1);",
              "pm.environment.set(\"leaveStartDate\", date.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Leave request is created\", () => pm.response.to.have.status(201));",
              "const request = pm.response.json();",
              "pm.expect(request.status).to.eql(\"PENDING\");",
              "pm.environment.set(\"approvedRequestId\", String(request.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{approveEmployeeAccessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"leaveTypeId\": {{vacationLeaveTypeId}},\n  \"startDate\": \"{{leaveStartDate}}\",\n  \"endDate\": \"{{leaveStartDate}}\",\n  \"notes\": \"Postman approval flow\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/requests"
      }
    },
    {
      "name": "06. JSmith checks request and assigned approver",
      "description": "Confirm the created request belongs to JSmith and is assigned to manager Chen before the manager acts on it.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{approveEmployeeAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/requests/{{approvedRequestId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee can read their request\", () => pm.response.to.have.status(200));",
              "const request = pm.response.json();",
              "pm.expect(String(request.id)).to.eql(pm.environment.get(\"approvedRequestId\"));",
              "pm.expect(String(request.employeeId)).to.eql(pm.environment.get(\"approveEmployeeId\"));",
              "pm.environment.set(\"requestApproverId\", String(request.approverId));",
              "pm.test(\"Manager Chen is the assigned approver\", () => pm.expect(String(request.approverId)).to.eql(pm.environment.get(\"managerUserId\")));"
            ]
          }
        }
      ]
    },
