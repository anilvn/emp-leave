    {
      "name": "13. Manager Chen reviews pending approvals",
      "description": "Open the manager dashboard after all employee requests exist. Check that it includes JSmith's approval request and CWong's rejection request; ALee's cancelled request should no longer be pending.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "access_token={{managerAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/approvals/pending"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Manager pending dashboard is available\", () => pm.response.to.have.status(200));",
              "const pending = pm.response.json();",
              "pm.test(\"Dashboard includes JSmith's request\", () => pm.expect(pending.some(request => String(request.id) === pm.environment.get(\"approvedRequestId\"))).to.eql(true));",
              "pm.test(\"Dashboard includes CWong's request\", () => pm.expect(pending.some(request => String(request.id) === pm.environment.get(\"rejectRequestId\"))).to.eql(true));",
              "pm.test(\"Dashboard excludes cancelled request\", () => pm.expect(pending.some(request => String(request.id) === pm.environment.get(\"cancelRequestId\"))).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Manager Chen approves JSmith's request",
      "description": "Approve the first employee request with an optional comment. The response should become APPROVED and the balance reservation should be deducted.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{managerAccessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Approved by the Postman demo flow.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/approvals/{{approvedRequestId}}/approve"
      },
      "event": [
