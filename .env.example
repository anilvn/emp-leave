# Copy to .env and set real values before `docker compose up`.
# .env is gitignored so these never get committed (NFR8, AD-13).

# HMAC signing secret for the auth JWT. Must be at least 32 bytes.
# Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=

# Local Postgres credentials (the compose database only).
DB_USERNAME=leave
DB_PASSWORD=leave
